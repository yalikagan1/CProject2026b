; err_instructions.as
; Operation, operand and directive errors. One error per line.
; Expected: all reported with line numbers, no output files.

; --- unknown operations ---
ADD $1, $2, $3
addx $1, $2, $3
stop

; --- bad registers ---
add $32, $1, $2
add $-1, $1, $2
add r3, $1, $2
add $, $1, $2

; --- operand count ---
add $1, $2
add $1, $2, $3, $4
move $1, $2, $3
hlt $1
add

; --- commas ---
add $1 $2 $3
add $1,, $2, $3
add, $1, $2, $3
add $1, $2, $3,
add $1, $2, $3 garbage

; --- immediates ---
addi $9, 32768, $8
addi $9, -32769, $8
addi $9, abc, $8
addi $9, $5, $8
addi $9, 1.5, $8
addi $9, 0x1F, $8

; --- wrong operand kind for J type ---
la $5
jmp 100
call $3

; --- branch target that is not a label ---
bne $1, $2, $5

; --- numeric directives ---
.db
.db 1,,2
.db 1,2,
.db ,1,2
.db 1 2
.db 1, abc
.db 128
.db -129
.dh 32768
.dh -32769
.dw 2147483648

; --- string directive ---
.asciz abc
.asciz "abc
.asciz "abc" "def"
.asciz

; --- directives that do not exist in this assembly language ---
.data 1, 2, 3
.string "abc"
.DB 1, 2
.
